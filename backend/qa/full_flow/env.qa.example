# HuntAI Test · full-flow QA environment (template)
#
# Do not copy this file by hand: `qa.sh init` generates `.env.qa` with local
# random secrets and a database derived from the repository root `.env`.
# This template exists so a reviewer can see every key the kit writes.
#
# `.env.qa` is ignored by `.gitignore` (`.env.*`). Never commit real values.

# ---- product settings (exported before API / mock IdP start) ----
APP_ENV='development'
APP_PORT='8013'
LOG_LEVEL='info'
DATABASE_URL='postgresql+asyncpg://<user>:<password>@127.0.0.1:5432/huntai_qa'
SESSION_COOKIE_NAME='huntai_qa_session'
SESSION_COOKIE_SAMESITE='Lax'
SESSION_COOKIE_SECURE='false'
SESSION_TTL_SECONDS='28800'
OIDC_LOGIN_DRAFT_TTL_SECONDS='600'
REAUTH_WINDOW_SECONDS='300'
APPROVAL_TTL_SECONDS='900'
OIDC_ISSUER='http://127.0.0.1:8190'
OIDC_CLIENT_ID='huntai-qa'
OIDC_CLIENT_SECRET='<generated>'
OIDC_REDIRECT_URI='http://127.0.0.1:5180/api/v1/auth/oidc/callback'
OIDC_CLAIM_SUBJECT='sub'
GITHUB_WEBHOOK_SECRET='<generated>'
JENKINS_WEBHOOK_SECRET='<generated>'
JENKINS_API_TOKEN='local-jenkins-token'
ARTIFACT_ROOT='<repo>/backend/qa/full_flow/.runtime/artifacts'
TEST_RUN_HEARTBEAT_TIMEOUT_SECONDS='300'
CI_LOG_CHUNK_BYTES='65536'
CI_LOG_MAX_TOTAL_BYTES='10485760'
REPORT_PARSE_TIMEOUT_SECONDS='60'
REPORT_PARSE_BATCH_ROWS='500'
VITE_API_BASE_URL=''

# ---- QA control plane ----
QA_API_PORT='8013'
QA_WEB_PORT='5180'
QA_IDP_PORT='8190'
QA_MOCK_PORT='8091'
QA_JENKINS_PORT='8088'
QA_DB_NAME='huntai_qa'
QA_TEST_DB_NAME='huntai_test_qa'
QA_BASE_URL='http://127.0.0.1:8013'
QA_WEB_URL='http://127.0.0.1:5180'
QA_JENKINS_URL='http://127.0.0.1:8088'
QA_CI_CONNECTOR_ID='00000000-0000-4000-8000-000000000012'

# ---- optional, not used by the product AI path ----
DEEPSEEK_API_KEY=''
DEEPSEEK_BASE_URL='https://api.deepseek.com'
DEEPSEEK_MODEL='deepseek-chat'
